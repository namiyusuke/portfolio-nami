---
import { SITE } from "../config";
import GlobalNavLink from "./GlobalNavLink.astro";
import logo from "@assets/images/logo.svg";
const { pathname } = Astro.url;

const Element = pathname === "/" ? "h1" : "p";

const navLists = [
  {
    name: "Sample",
    url: `${SITE.base}/sample/`,
  },
];
---
<header class="header">
  <h1 class="logo__text">
    <span
      class="logo__shape"
      role="img"
      aria-label={SITE.name}
      style={`--logo:url(${logo.src}); width:${logo.width}px; height:${logo.height}px;`}
    ></span>
  </h1>
  <nav class="header-nav">
    <ul class="header-nav-list">
      <li class="header-nav-item">
        <a href={`${SITE.base}/`}>
          Top
        </a>
      </li>
      <li class="header-nav-item">
        <a href={`${SITE.base}/#animation`}>
          Animation
        </a>
      </li>
      <li class="header-nav-item">
        <a href={`${SITE.base}/#projects`}>
         Projects
        </a>
      </li>
      <li class="header-nav-item">
        <!-- data-no-swup: Swup は preventDefault を見ないため、これが無いと
             「現在ページへのリンク」扱いでページ先頭へスクロールされてしまう -->
        <a href="#" class="js-about-open" data-no-swup>
         About
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .header{
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    color: #fff;
    padding-inline:74px;
    padding-block:40px;
    /* イントロのキャンバスは背景を透かすため、z-index では隠しきれない。
       イントロが終わる(hero-intro.js が html に is-intro-done を付ける)までは
       ヘッダー自体を隠しておく。イントロが無いページでは即付く */
    visibility: hidden;
    opacity: 0;
  }
  :global(html.is-intro-done) .header {
    visibility: visible;
    opacity: 1;
    transition: opacity 0.8s var(--ease-out-cubic);
  }
.header-nav-list{
  display: flex;
  gap: 26px;
  justify-content: flex-end;
  align-items: center;
}
</style>
