---
import { SITE } from "../config";
import GlobalNavLink from "./GlobalNavLink.astro";
import logo from "@assets/images/logo.svg";
const { pathname } = Astro.url;

const Element = pathname === "/" ? "h1" : "p";

const navLists = [
  {
    name: "Sample",
    url: `${SITE.base}/sample/`,
  },
];
---
<header class="header">
  <h1 class="logo__text">
    <span
      class="logo__shape"
      role="img"
      aria-label={SITE.name}
      style={`--logo:url(${logo.src}); width:${logo.width}px; height:${logo.height}px;`}
    ></span>
  </h1>
  <nav class="header-nav">
    <ul class="header-nav-list">
      <li class="header-nav-item">
        <a href="#">
          Top
        </a>
      </li>
      <li class="header-nav-item">
        <a href="#">
          Animation
        </a>
      </li>
      <li class="header-nav-item">
        <a href="#">
         Projects
        </a>
      </li>
      <li class="header-nav-item">
        <!-- JS が動かない環境では about ページへの素の遷移にフォールバックする -->
        <a href="#" class="js-about-open">
         About
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .header{
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    color: #fff;
    padding-inline:74px;
    padding-block:40px;
  }
.header-nav-list{
  display: flex;
  gap: 26px;
  justify-content: flex-end;
  align-items: center;
}
</style>
