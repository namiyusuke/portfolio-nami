---
// Config
import { SITE, SNS } from "../config";

// Style
import "@styles/global.css";
import "@styles/_swup-transition.scss";

// Component
import GlobalFooter from "@components/GlobalFooter.astro";
import GlobalHeader from "@components/GlobalHeader.astro";
import GoogleAnalytics from "@components/GoogleAnalytics.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="ja" data-script-disabled>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE.url}${SITE.base}/ogp.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {SNS.x && <meta name="twitter:site" content={SNS.x} />}
    <title>{title}</title>
    <link rel="canonical" href={Astro.url} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@300;400;500;700;900&family=Zen+Old+Mincho:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <link rel="icon" href={`${SITE.base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${SITE.base}/favicon.svg`} type="image/svg+xml" />
    {SITE.trackingId && isProd && <GoogleAnalytics />}
  </head>
  <body>
    <!-- (1) body 直下: ローディング画面 + 遷移カーテン -->
    <div class="c-loading">
      <div class="c-loading__inner">
        <div class="c-loading__counter">000</div>
        <div class="c-loading__bar"><span class="c-loading__bar-fill"></span></div>
      </div>
    </div>
    <div class="c-transition" aria-hidden="true"></div>

    <!-- (2) header / nav は #swup の外(遷移時に保持される) -->
    <GlobalHeader />

    <!-- (3) ページごとに中身が変わる範囲を #swup で囲う -->
    <div id="swup" class="transition-fade">
      <slot />
    </div>

    <!-- (4) footer も #swup の外 -->
    <GlobalFooter />

    <!-- (5) Swup + GSAP バンドル。Astro が初回に1度だけ実行する -->
    <script src="../js/main.js"></script>
  </body>
</html>
</content>
</invoke>
