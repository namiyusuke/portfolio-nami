  .hero {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    /* cover-bg の手前に重ねる */
    z-index: 1;
    will-change: opacity;
    /* cover-bg へのクロスフェード */
    transition: opacity 0.6s ease;
  }
  /* IntersectionObserver で付与。video をフェードアウトして cover-bg を見せる */
  .hero.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* hero が fixed なので、1画面分のスクロール領域を確保する */
  .hero-spacer {
    height: 100vh;
  }

  .marquee {
    position: relative;
    /* cover-bg(0)・hero(1) より前面に表示 */
    z-index: 2;
    overflow: hidden;
    width: 100%;
    /* translateY のずれ分を上下に確保して見切れを防ぐ */
    padding-block: 60px;
  }

  .marquee__track {
    display: flex;
    align-items: center;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    /* 2セット分を流すので -50% で1周 */
    animation: marquee-scroll 40s linear infinite;
  }

  /* ホバー中はスクロールを一時停止 */
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__item {
    flex: 0 0 auto;
    position: relative;
    z-index: 0;
  }
  /* ホバー中の画像を最前面に持ち上げて、隣に潜らないようにする */
  .marquee__item:hover {
    z-index: 10;
  }
  /* 上下にランダムっぽくずらす */
  .marquee__item:nth-child(5n + 1) { transform: translateY(-40px); }
  .marquee__item:nth-child(5n + 2) { transform: translateY(20px); }
  .marquee__item:nth-child(5n + 3) { transform: translateY(-10px); }
  .marquee__item:nth-child(5n + 4) { transform: translateY(48px); }
  .marquee__item:nth-child(5n + 5) { transform: translateY(8px); }

  .marquee__item img {
    display: block;
    height: 120px;
    width: auto;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .marquee__item:hover img {
    transform: scale(1.2);
    display: block;
  }
