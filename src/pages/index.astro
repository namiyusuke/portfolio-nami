---
// Config
import { SITE } from "@src/config";

// Layout
import Layout from "@layouts/Layout.astro";
import { getNotePosts } from "../libs/note";

// Assets
import coverBg from "@src/assets/images/cover-bg.jpg";
import mvText from "@src/assets/images/mv-text.svg";
import logoPrimary from "@src/assets/images/logo-primary.svg";
import heroIntroText from "@src/assets/images/hero-intro-text.svg";
import headingProject from "@src/assets/images/heading-project.svg";
// Sanity から project 一覧を取得
import { getProjects, getAnimations, imageAspectRatio, urlFor } from "@src/libs/sanity";
const animations = await getAnimations(10);
const projects = await getProjects(10);
console.log(projects);
// note の RSS から記事(タイトル・サムネイル・URL)を取得
// const notePosts = await getNotePosts(10);
---

<Layout title={`ページタイトル | ${SITE.name}`} description="ページの紹介文">

  <section class="p-hero js-hero-holo">
    <div class="p-hero__stage">
      <div class="p-hero__canvas js-hero-canvas" aria-hidden="true"></div>
    </div>
  </section>
  <section
    class="p-animation js-animation-slider"
    style={`--p-animation-count:${animations.length}`}
  >
    <h2 class="p-animation__title p-project__title">Animation</h2>
    <div class="p-animation__stage">
      <div class="p-animation__canvas js-animation-canvas" aria-hidden="true"></div>
      <ul class="p-animation__list">
        {animations.map((animation) => (
          <li
            class="p-animation__list-item js-animation-item"
            data-texture={animation.thumbnail
              ? urlFor(animation.thumbnail).width(1200).height(600).fit("crop").auto("format").url()
              : undefined}
            data-video={animation.video ?? undefined}
          >
            <a
              class="p-animation__link"
              href={animation.link}
            >
              <h3 class="p-animation__list-item-title">{animation.title}</h3>
              {animation.thumbnail && (
                <img
                  class="p-animation__list-item-thumb"
                  src={urlFor(animation.thumbnail).width(400).url()}
                  width="400"
                  height={Math.round(400 / animation.thumbnail.dimensions.aspectRatio)}
                  alt={animation.thumbnail.alt ?? animation.title}
                  loading="lazy"
                />
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="p-project js-project-fold">
    <div class="p-project__stage">
       <h2 class="p-project__title">projects</h2>
      <div class="p-project__canvas js-project-canvas" aria-hidden="true"></div>
      <ul class="p-project__list">
        {projects.map((project) => (
          <li
            class="p-project__list-item js-project-item"
            data-texture={project.thumbnail
              ? urlFor(project.thumbnail).width(1280).auto("format").url()
              : undefined}
            data-aspect={imageAspectRatio(project.thumbnail)}
            data-text={project.title}
          >
            <a class="p-project__link" href={`${SITE.base}/project/${project.slug.current}/`}>
              {/* <h3 class="p-project__list-item-title">{project.title}</h3> */}
              {project.thumbnail && (
                <img
                  class="p-project__list-item-thumb"
                  src={urlFor(project.thumbnail).width(400).url()}
                  width="400"
                  height={Math.round(400 / project.thumbnail.dimensions.aspectRatio)}
                  alt={project.thumbnail.alt ?? project.title}
                  loading="lazy"
                />
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  /* --------------------------------------------------------------
   FV
   既定は背景だけ。WebGL が使えて prefers-reduced-motion でもない場合だけ
   JS が .is-webgl を付けてキャンバスを立てる。
   モデルの読み込みが終わったら .is-ready でフェードインさせる。
  -------------------------------------------------------------- */
  .p-hero {
    position: relative;
    inset: 0;
    height: 100svh;
  }

  /* 全身 → 上半身へ寄せるためのスクロール区間。
     1画面ぶん余分に確保し、はみ出た量を 0〜1 に正規化してカメラを動かす。
     ここを 300svh にすればもっとゆっくり寄る。 */
  .p-hero.is-webgl {
    height: 200svh;
  }

  /* モデルの縁は alpha で抜くので、背面はサイト共通の背景
     (body::before のグラデーション)を透かす。
     body::before と同じ z-index: -1 のまま不透明色を敷くと、
     DOM 順でこちらが手前に来てグラデーションを覆ってしまう。 */
  .p-hero__stage {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: transparent;
  }

  .p-hero__canvas {
    display: none;
  }

  .is-webgl .p-hero__canvas {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  /* html.is-ready と混ざらないよう、セクション自身に付いた場合だけに絞る */
  .p-hero.is-ready .p-hero__canvas {
    opacity: 1;
  }

  /* renderer が差し込む canvas はスコープ外なので :global で拾う */
  .p-hero__canvas :global(canvas) {
    display: block;
  }

  /* --------------------------------------------------------------
   Animation セクション
   既定は素のリスト。WebGL が使える場合だけ JS が .is-webgl を付け、
   sticky + canvas のスライダー表示に切り替える。
  -------------------------------------------------------------- */
  .p-animation {
    position: relative;
  }

  /* スライド枚数ぶん（+ 最後の1枚が抜けるぶん）のスクロール量を確保する */
  .p-animation.is-webgl {
    height: calc((var(--p-animation-count) + 1) * 80svh);
  }

  .p-animation__title {
    color: #fff;
    font-family: var(--ff-mincho);
  }

  /* 板の縁は alpha で抜くので、背面はサイト共通の暗い背景を透かす */
  .is-webgl .p-animation__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    background-color: transparent;
  }

  .p-animation__canvas {
    display: none;
  }

  .is-webgl .p-animation__canvas {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* renderer が差し込む canvas はスコープ外なので :global で拾う */
  .p-animation__canvas :global(canvas) {
    display: block;
  }

  .is-webgl .p-animation__list {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    perspective: 800px;
  }

  /* 全項目を同じセルに重ね、GSAP が rotationX で円筒状に回す */
  .is-webgl .p-animation__list-item {
    grid-area: 1 / 1;
    backface-visibility: hidden;
  }

  .is-webgl .p-animation__list-item-title {
    color: #fff;
    font-family: var(--ff-mincho);
    font-size: clamp(24px, calc(48 / 1440 * 100vw), 48px);
    white-space: nowrap;
  }

  /* サムネは板のテクスチャとして描くので DOM 側は隠す */
  .is-webgl .p-animation__list-item-thumb {
    display: none;
  }

  /* --------------------------------------------------------------
   Projects セクション
   既定は素のリスト。WebGL2(=WebGPU のフォールバック先)が使える場合だけ
   JS が .is-webgl を付け、1画面のステージ表示に切り替える。
   板をクリックすると折りたたみが始まり(その間は .is-folded が付く)、
   折り終わりからそのまま詳細ページへ遷移する。
  -------------------------------------------------------------- */
  .p-project {
    position: relative;
    z-index: 10;
  }

  .p-project__title {
    color: #fff;
    font-family: var(--ff-mincho);
  }

  /* 板の縁は alpha で抜くので、背面はサイト共通の暗い背景を透かす */
  .is-webgl .p-project__stage {
    position: relative;
    height: 100svh;
    background-color: transparent;
  }

  .p-project__canvas {
    display: none;
  }

  .is-webgl .p-project__canvas {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* renderer が差し込む canvas はスコープ外なので :global で拾う */
  .p-project__canvas :global(canvas) {
    display: block;
  }

  /* 全項目を同じセルに重ね、表示中の1件だけ JS が opacity で出す。
     クリックは板（canvas）へ通したいので、リンク以外は当たり判定を切る */
  .is-webgl .p-project__list {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    align-content: end;
    justify-items: center;
    padding-bottom: clamp(24px, 8svh, 72px);
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  /* 折りたたみ中は見出しとプロジェクト名を消して板の動きだけを見せる。
     背景の流れる文字も sketch.js が同じ長さでフェードさせている
     (.p-project__title は Animation セクションと共用なので、セクションで絞る) */
  .p-project.is-webgl .p-project__title {
    transition: opacity 0.6s ease;
  }

  .is-webgl.is-folded .p-project__list,
  .p-project.is-webgl.is-folded .p-project__title {
    opacity: 0;
  }

  .is-webgl .p-project__list-item {
    grid-area: 1 / 1;
    text-align: center;
  }

  .is-webgl .p-project__link {
    display: inline-block;
    color: #fff;
    text-decoration: none;
    pointer-events: auto;
  }

  .is-webgl .p-project__list-item-title {
    font-family: var(--ff-mincho);
    font-size: clamp(24px, calc(48 / 1440 * 100vw), 48px);
    white-space: nowrap;
  }

  .is-webgl .p-project__list-item-subtitle {
    margin-top: 8px;
    font-size: 14px;
  }

  /* サムネは板のテクスチャとして描くので DOM 側は隠す */
  .is-webgl .p-project__list-item-thumb {
    display: none;
  }

