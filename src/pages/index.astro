<script>
  // 次セクション(marquee)を IntersectionObserver で監視し、
  // 画面に入ってきたら hero(video) をフェードアウトして背面の cover-bg を見せる
  const hero = document.querySelector<HTMLElement>(".hero");
  const trigger = document.querySelector<HTMLElement>(".js-section");

  if (hero && trigger) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        // marquee が画面に入ったら切り替え / 戻ったら video を再表示
        hero.classList.toggle("is-hidden", entry.isIntersecting);
      },
      // 画面下端から 120px 入ってきたら発火(=少しスクロールしてから切り替え)
      { rootMargin: "0px 0px -120px 0px", threshold: 0 },
    );

    observer.observe(trigger);
  }

  // hero-logoPrimary を上端 84px 地点でスクロール固定する(IntersectionObserver)
  const logo = document.querySelector<HTMLElement>(".hero-logoPrimary");
  const sentinel = document.querySelector<HTMLElement>(".hero-logoSentinel");

  if (logo && sentinel) {
    // 固定発火ライン(min(84/1440*100vw, 84px))を算出
    const getOffset = (): number => Math.min((84 / 1440) * window.innerWidth, 84);

    let observer: IntersectionObserver | null = null;

    const setup = (): void => {
      observer?.disconnect();
      const offset = getOffset();
      observer = new IntersectionObserver(
        ([entry]) => {
          // sentinel が 84px ラインより上に抜けたら固定
          const aboveLine = !entry.isIntersecting && entry.boundingClientRect.top < offset;
          logo.classList.toggle("is-fixed", aboveLine);
        },
        // root の上端を offset 分だけ下げて、その位置を判定ラインにする
        { rootMargin: `-${offset}px 0px 0px 0px`, threshold: 0 },
      );
      observer.observe(sentinel);
    };

    setup();
    // 画面幅で offset(=rootMargin)が変わるため、リサイズ時に再構築
    window.addEventListener("resize", setup);

    // footer までスクロールしたら logo を下方(546px ライン)へアニメーション
    const footer = document.querySelector<HTMLElement>(".footer");
    if (footer) {
      const footerObserver = new IntersectionObserver(
        ([entry]) => {
          logo.classList.toggle("is-bottom", entry.isIntersecting);
        },
        // 画面下端から 80% 上(=画面上部 20% 地点)に footer 上端が達したら発火
        { rootMargin: "0px 0px -80% 0px", threshold: 0 },
      );
      footerObserver.observe(footer);
    }
  }
</script>
