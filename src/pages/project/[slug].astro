---
// Config
import { SITE } from "@src/config";

// Layout
import Layout from "@layouts/Layout.astro";

// Sanity
import { toHTML } from "@portabletext/to-html";
import { getProjects, imageAspectRatio, urlFor, type Project } from "@src/libs/sanity";
import { DEFAULT_ASPECT } from "@src/js/libs/project-fold/plate-metrics.js";

// 静的ビルドなので、slug ごとのページを一覧からまとめて生成する
export const getStaticPaths = async () => {
  const projects = await getProjects(100);

  return projects.map((project) => ({
    params: { slug: project.slug.current },
    props: { project },
  }));
};

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { thumbnail } = project;

// メインビジュアルは一覧の板(WebGL)のテクスチャと同じ切り抜き・同じ URL にする。
// 遷移演出でめくれた板がこの位置へ収まるので、絵がずれないことと、
// 画像が使い回されて読み込みが起きないことの両方を狙っている。
// 板の比率は画像そのままなので、height は指定しない
// (width と height を両方渡すと image-url がその比率へ勝手に切り抜く)。
// index.astro の data-texture と同じ指定にしておくこと
const MAIN_WIDTH = 1280;
const heroAspect = imageAspectRatio(thumbnail) ?? DEFAULT_ASPECT;
const heroHeight = Math.round(MAIN_WIDTH / heroAspect);

// 概要は Portable Text。ビルド時に HTML へ起こして set:html で流し込む
const outlineHtml = project.outline?.length
  ? toHTML(project.outline, {
      components: {
        marks: {
          link: ({ children, value }) =>
            value?.blank
              ? `<a href="${value.href}" target="_blank" rel="noopener noreferrer">${children}</a>`
              : `<a href="${value?.href}">${children}</a>`,
        },
      },
    })
  : null;
---

<Layout
  title={`${project.title} | ${SITE.name}`}
  description={project.title}
>
  <main class="project">
    <div class="project__wrapper">
      <script is:inline define:vars={{ heroAspect }}>
        document.documentElement.style.setProperty("--p-project-hero-aspect", heroAspect);
      </script>
      <div
        class:list={[
          "project__hero",
          thumbnail ? "js-project-hero-stage" : "project__hero--text",
        ]}
      >
        {
          thumbnail && (
            <figure class="project__thumb">
              <img
                class="js-project-hero"
                crossorigin="anonymous"
                src={urlFor(thumbnail).width(MAIN_WIDTH).auto("format").url()}
                width={MAIN_WIDTH}
                height={heroHeight}
                alt={thumbnail.alt ?? project.title}
              />
            </figure>
          )
        }
      </div>
        <div class="project__head-wrapper">
          <div class="project__head">
            <h1 class="project__title">{project.title}</h1>
          </div>
             <div class="project__head-wrapper">
              <ul class="project__image-list js-project-gallery">
                {project.images && project.images.map((image) => (
                  <li>
                    <img
                      class="js-project-gallery-item"
                      crossorigin="anonymous"
                      src={urlFor(image).width(1600).auto("format").url()}
                      width={image.dimensions.width}
                      height={image.dimensions.height}
                      alt={image.alt ?? project.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </li>
                ))}
              </ul>
            </div>
          <div class="project__body">
            <p class="project__back project__view">
              <a target="_blank" rel="noopener noreferrer" href={project.link ?? "#"}>View site</a>
            </p>
          </div>
            <div class="project__detail-wrapper">
              <section class="project__detail-section">
                {outlineHtml && (
                  <div class="project__outline-wrapper">
                    <h3 class="project__outline-title project-detail__ttl">
                     概要
                    </h3>
                    <div class="project__outline" set:html={outlineHtml} />
                  </div>
                )}
              </section>
              <section class="project-member project__detail-section">
                <h3 class="project-member__ttl project-detail__ttl">
                  Project Member
                </h3>
                <div class="project-member__list-wrapper">
                  <ul class="project-member__list">
                    {project.credits && project.credits.map((credit) => (
                      <li class="project-member__item">
                        <span class="project-member__role">{credit.role}</span>
                        <span class="project-member__name">{credit.name}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </section>
            </div>
        </div>
      <div class="project__body project__body--back">
        <p class="project__back">
          <a href={`${SITE.base}/#projects`}>Back to list</a>
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .project {
    position: relative;
    z-index: 10;
    color: #282727;
  }

  /* --------------------------------------------------------------
   メインビジュアル
   一覧の板(WebGL)がめくり終わった位置・大きさにそのまま重なるよう、
   画面幅 × 100svh のステージの中央に、板と同じ寸法で置く。
   実寸は project-hero.js が html の --p-project-hero-w / -h に書き込む。
   下の値は JS が動くまでの目安で、plate-metrics.js の
   PLATE_WIDTH(1440px) / PLANE_FIT(0.82) と同じ式。
   幅の基準は「本文の幅(95vw)」ではなく一覧の canvas と同じ画面幅なので vw で書く。
   比率(--p-project-hero-aspect)はプロジェクトごとに違うので、上のインラインスクリプトが
   元画像の比率を html に流し込む（流れてこなければ既定の 1.6 のまま）。
   ここは html に置く。板とメインビジュアルより内側で宣言すると
   JS が書いた値を上書きしてしまい、遷移で画像がズレる。
  -------------------------------------------------------------- */
  :global(html) {
    --p-project-hero-aspect: 1.6;
    --p-project-hero-w: min(1440px, 82vw, calc(82svh * var(--p-project-hero-aspect)));
    --p-project-hero-h: calc(var(--p-project-hero-w) / var(--p-project-hero-aspect));
  }

  /* スマホは板を大きく映す。上限は本文カラム(.project__wrapper = 95vw)と同じ。
     plate-metrics.js の PLANE_FIT_NARROW(0.95) / NARROW_STAGE_WIDTH(768) と揃えること */
  @media (max-width: 767px) {
    :global(html) {
      --p-project-hero-w: min(1440px, 95vw, calc(95svh * var(--p-project-hero-aspect)));
    }
  }

  .project__hero {
    --p-project-hero-top: calc((100svh - var(--p-project-hero-h)) / 2);

    position: relative;
    height: 100svh;
  }
.project__head-wrapper{
  @media (--md) {
    width: var(--p-project-hero-w);
    margin-inline: auto;
  }
}


  .project__thumb {
    position: absolute;
    inset-inline: 0;
    top: var(--p-project-hero-top);
    width: var(--p-project-hero-w);
    margin-inline: auto;
  }

  .project__thumb img {
    display: block;
    width: 100%;
    height: auto;
  }


  /* サムネイルが無い場合は素直に流し込む */
  .project__hero--text {
    height: auto;
    padding-block: clamp(56px, 12vw, 120px);
  }

  .project__hero--text .project__head {
    position: static;
    text-align: left;
  }

  .project__title {
    font-family: var(--ff-mincho);
    font-size: clamp(28px, 6vw, 40px);
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
    margin-block: 0;
    margin-bottom: clamp(32px, 6vw, 60px);
  }

  .project__subtitle {
    margin-top: 12px;
    font-size: 16px;
  }
  .project__body {
    width: calc(1196 / 1440 * 100%);
    margin-inline: auto;
    padding-top: clamp(56px, 12vw, 120px);
  }

  .project__back {
    margin-top: clamp(32px, 6vw, 60px);
    text-align: center;
  }
   @media (--md) {
  .project__back {
    margin-top: 160px;
    text-align: center;
  }
  .project__view{
    margin-top: 0px;
  }
   }
  .project__back a {
    display: inline-flex;
    padding-inline: 2rem;
    padding-block: calc(12 / 16 * 1rem);
    font-size: 14px;
    color: #fff;
    border: #fff 1px solid;
    line-height: 1.2;
  }
  .project__head-wrapper li img {
    display: block;
    width: 100%;
    height: auto;
  }
  .project__image-list li + li {
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .project__image-list img.is-webgl {
    visibility: hidden;
  }
  .project-detail__ttl {
    font-size: clamp(18px, 4.5vw, 20px);
    line-height: 1.8;
    color: #fff;
    margin-bottom: 30px;
  }
   @media (--md) {
      .project-detail__ttl {
        min-width: 100px;
        margin-bottom: 0;
      }
   }
  .project__outline {
    font-size: 16px;
    line-height: 1.8;
    color: #fff;
  }

  .project__outline :global(h4) {
    margin-top: 2rem;
    font-size: 18px;
  }

  .project__outline :global(p + p),
  .project__outline :global(ul),
  .project__outline :global(ol) {
    margin-top: 1rem;
  }

  .project__outline :global(ul) {
    padding-left: 1.5em;
    list-style: disc;
  }

  .project__outline :global(ol) {
    padding-left: 1.5em;
    list-style: decimal;
  }

  .project__outline :global(a) {
    color: inherit;
    text-decoration: underline;
  }
.project-member{
  color: #fff;
}
@media (--md) {
  .project-member{
    display: flex;
  }
}
.project__detail-section + .project__detail-section{
  margin-top: 80px;
}
@media (--md) {
  .project__detail-section + .project__detail-section{
  margin-top: 100px;
}
}
/* SP は本文カラムを目一杯使い、md 以上で右寄せの狭いカラムへ戻す */
.project__outline,
.project-member__list-wrapper{
  width: 100%;
  margin-left: auto;
}
.project-member__item{
  display: flex;
  /* SP は 役割 / 名前 を縦積みにする(横並びだと名前が潰れる) */
  flex-direction: column;
  gap: 0.25rem;
}
.project-member__item + .project-member__item{
  margin-top: clamp(1.2rem, 3vw, 2rem);
}
.project__detail-wrapper{
  margin-top: 90px;
  padding-top: 90px;
  border-top: 1px solid #fff;
}
@media (--md) {
  .project__detail-wrapper{
  margin-top: 160px;
  padding-top: 100px;
}
}
@media (--md) {
  .project__outline{
    width: min(calc(1000 / 1440 * 100vw), 1000px);
  }
  .project-member__item{
    flex-direction: row;
    gap: 0;
  }
  .project-member__role{
    width: 200px;
    flex-shrink: 0;
  }
    .project-member__ttl{
      min-width: 300px;
  }
}
.project__body--back{
  padding-top: 0;
  padding-bottom: clamp(56px, 12vw, 120px);
}
.project__wrapper{
  width: 90vw;
  margin-inline: auto;
}
@media (--md) {
.project__wrapper{
  width: 95vw;
  margin-inline: auto;
}
}
</style>
