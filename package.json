{
  "name": "kuuche-design",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint",
    "format": "oxfmt src astro.config.mjs",
    "format:check": "oxfmt --check src astro.config.mjs",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:html": "markuplint \"src/**/*.astro\"",
    "lint:all": "pnpm lint && pnpm lint:css && pnpm lint:html"
  },
  "dependencies": {
    "astro": "^6.4.7"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": ["darwin", "linux"],
      "cpu": ["arm64", "x64"]
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@markuplint/astro-parser": "^4.18.3",
    "@yu_nami/markuplint-config": "^0.0.6",
    "@yu_nami/oxfmt-config": "^0.0.2",
    "@yu_nami/oxlint-config": "^0.0.2",
    "@yu_nami/stylelint-config": "^0.0.4",
    "markuplint": "^4.18.3",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "stylelint": "^17.13.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "typescript": "^6.0.3"
  }
}
